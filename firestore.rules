rules_version = '2';

// Rashio — every document lives under /users/{uid}/ and is only
// readable/writable by the signed-in owner. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPayment(d) {
      return d.keys().hasAll(['contract', 'type', 'earningsCents', 'status', 'payoutDate'])
        && d.contract is string && d.contract.size() > 0 && d.contract.size() <= 300
        && d.type in ['hourly', 'incentive', 'work_trial', 'other']
        && d.earningsCents is int
        && d.earningsCents >= -100000000 && d.earningsCents <= 100000000
        && d.status in ['paid', 'pending', 'processing', 'failed', 'other']
        && (d.payoutDate == null || d.payoutDate is string)
        && (!('hours' in d) || d.hours == null || d.hours is number)
        && (!('rateCents' in d) || d.rateCents == null || d.rateCents is int);
    }

    // Profile & settings document
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.size() < 50;
    }

    match /users/{uid}/payments/{paymentId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPayment(request.resource.data);
    }

    match /users/{uid}/imports/{importId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner(uid) && docId in ['sync', 'summary'];
    }

    // Deny everything not matched above (explicit for clarity).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
